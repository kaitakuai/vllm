# Fast Python-only overlay for the decode-PoC image.
#
# All decode-PoC changes are Python (vllm/poc/*.py + a few engine .py). The compiled
# CUDA/C++ is unchanged from the base, so there is NO need to rebuild from source for
# Python-only iterations. This layer copies the repo's .py files over the installed
# vllm package in an already-built image — a ~5-second build instead of hours.
#
# Use ONLY for Python-only changes. If C++/CUDA, torch/CUDA version, or the arch list
# changes, rebuild from docker/Dockerfile instead.
#
#   docker build -f docker/Dockerfile.poc-overlay \
#     --build-arg BASE=ghcr.io/axeltec-software/vllm:v0.20-decode-poc-cu128 \
#     -t ghcr.io/axeltec-software/vllm:v0.20-decode-poc-cu128-r2 .
ARG BASE=ghcr.io/axeltec-software/vllm:v0.20-decode-poc-cu128
FROM ${BASE}

# Overlay every .py from the repo's vllm/ tree onto the installed package. Compiled
# artifacts (.so, cubins) in the base are left untouched.
COPY vllm /tmp/vllm_overlay
RUN set -eu; \
    D=$(python -c "import vllm, os; print(os.path.dirname(vllm.__file__))"); \
    echo "overlaying Python onto $D"; \
    cd /tmp/vllm_overlay && \
    find . -name '*.py' -printf '%P\n' | while read -r f; do \
      install -D -m644 "/tmp/vllm_overlay/$f" "$D/$f"; \
    done; \
    rm -rf /tmp/vllm_overlay; \
    python -c "import vllm.poc.mixed_decode, vllm.poc.native; print('overlay import OK')"
